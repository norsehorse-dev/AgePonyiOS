scheme("AgePonySnapshots")

# AgePony is iPhone only and English only. The 6.9" set is the one App Store
# Connect requires; it scales down for smaller iPhones.
devices([
  "iPhone 17 Pro Max",
])

languages([
  "en-US",
])

launch_arguments(["-seedDemoVault"])

# Raw captures. tools/frame_screenshots.py turns them into the captioned
# frames in fastlane/screenshots, which is what deliver uploads.
output_directory("./fastlane/raw_screenshots")
clear_previous_screenshots(true)
override_status_bar(true)
dark_mode(false)
